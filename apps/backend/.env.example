ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=25
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Tesseract languages, joined with "+". Each one added slows OCR down, so keep
# this to the scripts you actually expect. Languages that are not installed are
# dropped with a warning rather than failing the conversion.
# Also available in the Docker image: chi_sim, jpn, ara, hin, rus
OCR_LANGUAGES=eng+fra+deu+spa+ita+por+nld

# Logs the underlying library error message on failures, not just the exception
# type. Useful for QA; leave off in production, where a message could quote part
# of a user's document.
LOG_ERROR_DETAIL=false
