ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=25
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Tesseract languages, joined with "+". Each one added slows OCR down roughly
# proportionally, so keep this to the scripts you actually expect. Languages
# that are not installed are dropped with a warning rather than failing the
# conversion. Installed in the Docker image and available to enable here:
# fra, deu, spa, ita, por, nld, chi_sim, jpn, ara, hin, rus
OCR_LANGUAGES=eng

# Resolution used to render PDF pages before OCR. Cost is roughly quadratic:
# drop toward 100 if scanned pages time out, raise toward 300 if there is CPU
# headroom. Below ~150 Tesseract accuracy falls off noticeably.
OCR_DPI=150

# Logs the underlying library error message on failures, not just the exception
# type. Useful for QA; leave off in production, where a message could quote part
# of a user's document.
LOG_ERROR_DETAIL=false
